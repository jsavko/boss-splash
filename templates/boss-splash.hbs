
<div class='bossOverlay'>
  <style>
    .slide-right {
  animation-duration: {{animationDuration}}s;
  animation-name:  slide-right;
}

.sub-slide-right {
  animation-duration: {{animationDuration}}s;
  animation-name: sub-slide-right;
}

.slide-left { 
  animation-duration: {{animationDuration}}s;
  animation-name:  slide-left;
}

.silhouette-reveal {
  animation-name: slide-left, silhouette-fade;
  animation-duration: {{animationDuration}}s, {{revealDuration}}s;
  animation-delay: 0s, {{animationDuration}}s;
  animation-fill-mode: none, forwards;
}

  </style>
  <div class="actorArt">
  <img name="actorImg" class="slide-left" src="{{actorImg}}"> 
  {{#if revealDuration}}
  <img name="actorImgSilhouette" class="silhouette-reveal actorSilhouette" src="{{actorImg}}">
  {{/if}}
  </div>
  <div class='colorBand'>
    <div class='colorFirst' style="background-color: {{colorFirst}}">
          <h2 name="bossMessage" class="slide-right" style="color: {{colorFont}}; text-shadow: 3px 3px {{colorShadow}}; font-family: {{fontFamily}}; font-size: {{fontSize}}">
          {{message}}
          </h2>
    </div>
    <div class='colorSecond' style="background-color: {{colorSecond}}">
          {{#if subText}}
          <h3 name="bossSubText" class="sub-slide-right" style="color: {{subColorFont}}; text-shadow: 3px 3px {{subColorShadow}}; font-family: {{fontFamily}}; font-size: {{subFontSize}}">
          {{subText}}
          </h3>
          {{/if}}
    </div>
    <div class='colorThird'  style="background-color: {{colorThird}}"></div>
  </div>
</div>